#!/usr/bin/env python3
"""phone: drive the owner's phone through the Mobile Use hub (for any agent that can run commands).

  phone status                 connected? app in front, locked, stopped
  phone look                   numbered list of buttons/fields/text (coordinates in screen pixels)
  phone screenshot > s.jpg     JPEG, 540 px wide (multiply by screen_width/540 for screen pixels)
  phone click N                tap element N from the last `phone look`
  phone tap X Y                tap screen pixels
  phone type N "text" [enter]  type into field N (any language); add enter to submit
  phone key back|home|recent|notifications
  phone scroll down|up|left|right
  phone open "WhatsApp"        open an app by name
  phone apps                   list apps
  phone find "text"            scroll until text is visible
  phone wait "text" [seconds]  wait until text appears
  phone ask "question"         slide-to-approve card; prints allow_once, allow_session, deny, or timeout
  phone task "verbatim request"  arm cash-on-delivery auto-complete when the request names the app and COD
  phone checkout               what payment method the screen shows
  phone log                    recent approvals and COD orders
  phone policy [on|off]        cash-on-delivery auto-complete (on by default)
  phone revoke                 clear "approve for this session"

Reading, scrolling, and opening apps just run. Paying, sending, deleting, and installing
show a card on the phone: slide to approve, or it denies itself when the timer ends.
Password and PIN fields are refused. If the owner's request named the app and cash on delivery,
the final place-order tap completes the order only when that method is selected and the cart
matches the request. Otherwise the approval card is shown. If they tap Stop, stop.
"""
import json, os, socket, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import policy

HUB = os.environ.get("PHONE_HUB_SOCK", "/tmp/phone-hub.sock")
LOCK = os.environ.get("PHONE_LOCK_FILE", "/tmp/phone-agent.lock")
ME = os.environ.get("PHONE_AGENT_NAME", "cli-agent")  # shown in "phone busy" messages
LAST = f"/tmp/phonectl-last-look-{os.getuid()}.json"


def hub(cmd, args=None, timeout=60):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout + 5)
    try:
        s.connect(HUB)
    except (ConnectionRefusedError, FileNotFoundError):
        sys.exit("error: the phone hub isn't running")
    s.sendall((json.dumps({"cmd": cmd, "args": args or {}, "timeout": timeout}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        c = s.recv(1 << 20)
        if not c:
            break
        buf += c
    r = json.loads(buf or b'{"ok":false,"error":"no answer from hub"}')
    if not r.get("ok"):
        err = r.get("error", "phone error")
        if "stopped" in err:
            policy.get_store().clear_session()
        sys.exit("error: " + err)
    return r.get("result", {})


def claim():
    try:
        l = json.load(open(LOCK))
        pid = l["owner"].removeprefix("claude-")
        alive = not pid.isdigit() or os.path.exists(f"/proc/{pid}")
        if l["owner"] != ME and alive and time.time() - l["ts"] < 120:
            sys.exit(f"phone busy: {l['owner']} is using it ({int(time.time() - l['ts'])} s ago). Try again in 2 minutes.")
    except (OSError, ValueError, KeyError):
        pass
    try:
        with open(LOCK, "w") as f:
            json.dump({"owner": ME, "ts": time.time()}, f)
        os.chmod(LOCK, 0o666)
    except OSError:
        pass


def load_look():
    try:
        data = json.load(open(LAST))
    except OSError:
        sys.exit("run `phone look` first")
    if isinstance(data, list):  # older look files were a bare list
        return "", data
    return data.get("app", ""), data.get("els", [])


def element(n):
    _app, els = load_look()
    if not 1 <= n <= len(els):
        sys.exit(f"no element {n} in the last look; run `phone look` again")
    return els[n - 1]


def guard(e=None, what="", kind="tap", enter=False, text=""):
    seen_app, elements = ("", [])
    try:
        seen_app, elements = load_look()
    except SystemExit:
        if e is not None:
            raise
    try:
        return policy.authorize(
            hub, kind=kind, element=e, elements=elements, why=what, enter=enter,
            agent=ME, typed=text, seen_app=seen_app)
    except policy.ApprovalDenied as err:
        sys.exit(str(err))


def look():
    r = hub("look", {"shot": False})
    area = r["w"] * r["h"]
    els = [e for e in r["els"] if not (e["kind"] == "button" and len(e["label"]) >= 60 and
           (e["b"][2] - e["b"][0]) * (e["b"][3] - e["b"][1]) > 0.3 * area)]
    with open(LAST, "w") as f:
        json.dump({"app": r.get("app") or "", "els": els}, f)
    print(f"app: {r['app']}" + (" | keyboard open" if r.get("keyboard") else "")
          + (" | PHONE LOCKED (ask the owner to unlock; never type the PIN)" if r.get("locked") else ""))
    for n, e in enumerate(els, 1):
        x1, y1, x2, y2 = e["b"]
        name = repr(e["label"]) if e["label"] else f"id={e.get('id', '?')}"
        extra = " (password)" if e.get("password") else ""
        print(f"[{n}] {e['kind']} {name} at {(x1 + x2) // 2},{(y1 + y2) // 2}{extra}")


def main(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    c = a[0]
    if c == "status":
        print(json.dumps(hub("ping")))
    elif c == "look":
        look()
    elif c == "screenshot":
        import base64
        sys.stdout.buffer.write(base64.b64decode(hub("screenshot", {"width": 540})["jpeg"]))
    elif c == "click":
        claim(); e = element(int(a[1])); decision = guard(e, kind="tap")
        hub("click", {"i": e["i"], "approved": bool(decision.get("approved"))})
        note = " (cash-on-delivery order placed and logged)" if decision.get("auto_cod") else ""
        print(f"tapped {e['label']!r}{note}")
    elif c == "tap":
        claim(); guard(kind="tap")
        hub("tap", {"x": int(a[1]), "y": int(a[2])}); print("tapped")
    elif c == "type":
        claim(); e = element(int(a[1])); enter = len(a) > 3 and a[3] == "enter"
        decision = guard(e, kind="type", enter=enter, text=a[2])
        hub("set_text", {"i": e["i"], "text": a[2], "enter": enter,
                         "approved": bool(decision.get("approved"))})
        print("typed")
    elif c == "key":
        claim(); hub("global", {"key": a[1]}); print("pressed", a[1])
    elif c == "scroll":
        claim()
        t = hub("tree")
        w, h = t["w"], t["h"]
        m = {"down": (w // 2, int(h * .72), w // 2, int(h * .32)), "up": (w // 2, int(h * .32), w // 2, int(h * .72)),
             "left": (int(w * .85), h // 2, int(w * .15), h // 2), "right": (int(w * .15), h // 2, int(w * .85), h // 2)}
        x1, y1, x2, y2 = m[a[1]]
        hub("swipe", {"x1": x1, "y1": y1, "x2": x2, "y2": y2, "ms": 280}); print("scrolled", a[1])
    elif c == "open":
        claim()
        apps = hub("apps")["apps"]; k = a[1].lower()
        hits = [x for x in apps if x["name"].lower() == k or x["package"] == a[1]] or [x for x in apps if k in x["name"].lower()]
        if not hits:
            sys.exit(f"no app called {a[1]!r}; see `phone apps`")
        app = sorted(hits, key=lambda x: len(x["name"]))[0]
        hub("open_app", {"package": app["package"]}, timeout=20); print("opened", app["name"])
    elif c == "apps":
        for x in sorted(hub("apps")["apps"], key=lambda x: x["name"].lower()):
            print(f"{x['name']}: {x['package']}")
    elif c == "find":
        claim(); print(json.dumps(hub("find", {"text": a[1]}, timeout=60)))
    elif c == "wait":
        t = int(a[2]) if len(a) > 2 else 15
        print(json.dumps(hub("wait_for", {"text": a[1], "timeout": t}, timeout=t + 10)))
    elif c == "ask":
        print(hub("ask", {"title": "Question", "text": a[1], "why": "The agent is asking you to decide.",
                          "risk": "question", "timeout": 60}, timeout=80).get("answer"))
    elif c == "task":
        rec = policy.get_store().save_request(a[1], hub("apps").get("apps", []))
        print(policy.explain_request(rec))
    elif c == "checkout":
        r = hub("look", {"shot": False})
        area = r["w"] * r["h"]
        els = [e for e in r["els"] if not (e["kind"] == "button" and len(e["label"]) >= 60 and
               (e["b"][2] - e["b"][0]) * (e["b"][3] - e["b"][1]) > 0.3 * area)]
        with open(LAST, "w") as f:
            json.dump({"app": r.get("app") or "", "els": els}, f)
        print(policy.explain_checkout(r.get("app") or "", els))
    elif c == "log":
        limit = int(a[1]) if len(a) > 1 else 20
        print(policy.format_audit(policy.get_store().read_audit(limit)))
    elif c == "policy":
        if len(a) > 1:
            cfg = policy.set_cod_auto_complete(a[1].lower() in ("on", "1", "true", "yes"))
            policy.get_store().audit("policy", agent=ME, decision="on" if cfg["cod_auto_complete"] else "off",
                                     action="cod_auto_complete")
        else:
            cfg = policy.load_policy()
        print("cod_auto_complete", "on" if cfg["cod_auto_complete"] else "off")
    elif c == "revoke":
        policy.get_store().clear_session()
        print("session approvals cleared")
    else:
        sys.exit(f"unknown command {c!r}; run `phone help`")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (IndexError, ValueError):
        sys.exit("wrong arguments; run `phone help`")
