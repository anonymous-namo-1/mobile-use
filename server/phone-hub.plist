<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the Mobile Use hub on a Mac. Edit the paths and HUB_IP (from `tailscale ip -4`),
     copy to ~/Library/LaunchAgents/phone-hub.plist, then: launchctl load ~/Library/LaunchAgents/phone-hub.plist
     The Mac must stay awake for the phone to stay reachable. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.mobileuse.hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/mobile-use/server/.venv/bin/python</string>
    <string>/Users/YOUR_USER/mobile-use/server/hub.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PHONE_HUB_HOST</key><string>HUB_IP</string></dict>
  <key>WorkingDirectory</key><string>/Users/YOUR_USER/mobile-use/server</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/phone-hub.log</string>
  <key>StandardErrorPath</key><string>/tmp/phone-hub.log</string>
</dict>
</plist>
